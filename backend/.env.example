FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev_secret_key_change_me_in_production
JWT_SECRET_KEY=jwt_secret_key_change_me_in_production

# PostgreSQL Connection String (Default local template)
DATABASE_URL=postgresql://postgres:password@localhost:5432/farmfresh

# SQLite fallback can be used locally by uncommenting the line below:
# DATABASE_URL=sqlite:///farmfresh.db

# Path to save uploaded crop images
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
